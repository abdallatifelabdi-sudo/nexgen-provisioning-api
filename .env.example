# ─────────────────────────────────────────────────────────────────────────────
# NexGen AI Solutions — Render Environment Variables
# Copy this file to .env for local development.
# In Render: set these under Dashboard > Your Service > Environment
# ─────────────────────────────────────────────────────────────────────────────

# REQUIRED — API authentication key (Render can auto-generate this)
API_GATEWAY_KEY=your-32-char-random-string-here

# REQUIRED — OpenAI API key for creating client AI Assistants
OPENAI_API_KEY=sk-...

# REQUIRED — HighLevel (GoHighLevel) API key for sub-account creation
GHL_API_KEY=your-ghl-api-key

# REQUIRED — HighLevel Enterprise Snapshot ID
GHL_ENTERPRISE_SNAPSHOT_ID=your-snapshot-id

# REQUIRED — Make.com webhook URL to trigger welcome emails
MAKE_WEBHOOK_URL=https://hook.us1.make.com/your-webhook-id

# REQUIRED — Email address for engineering notifications
ENGINEER_EMAIL=engineering@nexgenaisolutions.com

# OPTIONAL — Slack incoming webhook URL for real-time alerts
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# OPTIONAL — ClickUp API key and list ID for task creation
CLICKUP_API_KEY=pk_...
CLICKUP_LIST_ID=your-list-id
